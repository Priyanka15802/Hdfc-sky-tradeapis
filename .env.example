# Copy this file to `.env` on the machine that actually runs the bot
# (your whitelisted EC2 instance) and fill in real values there.
# NEVER commit the real `.env` file — it is already listed in .gitignore.

# --- HDFC Sky Open API credentials ---
# Get these from https://developer.hdfcsky.com after registering your app.
HDFC_SKY_API_KEY=
HDFC_SKY_API_SECRET=
HDFC_SKY_CLIENT_ID=
HDFC_SKY_PASSWORD=
# Only needed if your login flow uses a TOTP-based second factor.
HDFC_SKY_TOTP_SECRET=

# --- API base URL ---
# TODO: confirm the exact base URL from the developer portal.
HDFC_SKY_BASE_URL=https://api.hdfcsky.com

# --- Networking ---
HDFC_SKY_REQUEST_TIMEOUT_SECONDS=10

# --- Local session cache (never commit this file either) ---
HDFC_SKY_SESSION_FILE=.session.json

# --- Safety switch ---
# When true, order methods log/print the payload instead of sending it.
# Flip to false only once you have verified endpoints/payloads are correct.
DRY_RUN=true
