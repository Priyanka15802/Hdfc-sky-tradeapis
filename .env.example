# Copy this file to `.env` on the machine that actually runs the tool
# (your whitelisted EC2 instance, or localhost for now) and fill in real
# values there. NEVER commit the real `.env` file — it's in .gitignore.

# --- HDFC Sky Open API credentials (from developer.hdfcsky.com) ---
HDFC_SKY_API_KEY=
HDFC_SKY_API_SECRET=

# Default client_id used to pre-fill order forms. You can also override it
# per-session in the tool's UI once logged in.
HDFC_SKY_CLIENT_ID=

# Value HDFC expects for the Authorise step's `consent` parameter. Not
# documented anywhere — set to whatever worked when you tested manually
# (e.g. "true").
HDFC_SKY_CONSENT=

# --- Flask ---
# Signs the session cookie that holds your token_id/request_token/access_token.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# --- Networking ---
HDFC_SKY_REQUEST_TIMEOUT_SECONDS=10

# --- Safety switch ---
# Starting value each time the app launches — the tool's UI also has a
# live toggle for this (with a confirmation before going live), but this
# is what it opens with if you forget to check. When true, every
# place/modify/cancel order call returns the exact request that *would*
# be sent instead of actually sending it.
DRY_RUN=true
